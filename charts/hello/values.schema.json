{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Valori del chart hello",
  "type": "object",
  "required": ["imageRegistry", "backend", "frontend"],
  "definitions": {
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "not": { "const": "latest" } },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": { "type": "object" },
        "limits": { "type": "object" }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "imageRegistry": { "type": "string", "minLength": 1 },
    "imagePullSecrets": { "type": "array", "items": { "type": "object", "required": ["name"] } },
    "backend": {
      "type": "object",
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 1 },
        "image": { "$ref": "#/definitions/image" },
        "config": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "existingSecret": { "type": "string" },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 20 },
        "resources": { "$ref": "#/definitions/resources" },
        "autoscaling": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "minReplicas": { "type": "integer", "minimum": 1 },
            "maxReplicas": { "type": "integer", "minimum": 1 },
            "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
          }
        },
        "pdb": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "minAvailable": { "type": ["integer", "string"] }
          }
        }
      }
    },
    "frontend": {
      "type": "object",
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 1 },
        "image": { "$ref": "#/definitions/image" },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "gatewayNamespace": { "type": "string" },
        "llmNamespace": { "type": "string" },
        "monitoringNamespace": { "type": "string" },
        "allowDebugPods": { "type": "boolean" }
      }
    },
    "httpRoute": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "gateway": {
          "type": "object",
          "required": ["name", "namespace"],
          "properties": { "name": { "type": "string" }, "namespace": { "type": "string" } }
        },
        "hostname": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$" },
        "httpsRedirect": { "type": "boolean" }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "interval": { "type": "string" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "tests": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" }, "image": { "type": "string" } }
    }
  }
}
